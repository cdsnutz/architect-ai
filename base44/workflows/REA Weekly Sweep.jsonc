{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * 1",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every Monday at 07:00, validates the oldest dossiers that never got a validation pass",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "rea_weekly_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sweep_dossiers": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reaSweep"
          },
          "then": "end",
          "x-base44": {
            "title": "Sweep backlog",
            "description": "Three dossiers per run"
          }
        }
      }
    ]
  },
  "name": "REA Weekly Sweep"
}