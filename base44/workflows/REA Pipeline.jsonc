{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "SiteAnalysis"
    }
  },
  "description": "Validates every newly mapped dossier and writes the verdict back onto it",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "rea_pipeline",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "validate_dossier": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reaValidate",
            "args": {
              "analysis_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Validation pod",
            "description": "Parity score and verdict"
          }
        }
      }
    ]
  },
  "name": "REA Pipeline"
}