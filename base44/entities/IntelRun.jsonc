{
  "name": "IntelRun",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "target_url": {
      "type": "string",
      "description": "Lead surface the intelligence pass read."
    },
    "competitor_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "auth_basis": {
      "type": "string",
      "enum": [
        "owned",
        "written_authorization",
        "staging_mirror"
      ],
      "enumColors": [
        "green",
        "blue",
        "purple"
      ]
    },
    "attestation": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "complete",
        "failed"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "running"
    },
    "modules": {
      "type": "object",
      "description": "Drift, ghost-page diff, semantic entropy and the synthetic path predictor."
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "target_url",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}