{
  "name": "SiteAnalysis",
  "type": "object",
  "properties": {
    "url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "logic_map": {
      "type": "object"
    },
    "rebuild_prompt": {
      "type": "string"
    },
    "white_label_prompt": {
      "type": "string"
    },
    "access_state": {
      "type": "string",
      "enum": ["public", "gated_captured", "gated_blocked", "gated_refused"],
      "description": "Whether the analyzed value sits behind authentication and whether gated surfaces were captured."
    },
    "gate_type": {
      "type": "string",
      "enum": ["none", "email_otp", "email_link", "unknown", "paid", "phone", "captcha"],
      "description": "How the target gates access. paid/phone/captcha are never automated."
    },
    "gated_routes": {
      "type": "number",
      "description": "Count of authenticated routes captured in this dossier."
    },
    "test_account_alias": {
      "type": "string",
      "description": "Gmail plus-alias of the authorized test account used for authenticated capture."
    },
    "white_label_brand": {
      "type": "string"
    }
  },
  "required": [
    "url",
    "title",
    "summary"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}