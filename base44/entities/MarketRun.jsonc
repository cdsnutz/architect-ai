{
  "name": "MarketRun",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Human label for the command pass."
    },
    "target_url": {
      "type": "string",
      "description": "Lead surface read as the baseline."
    },
    "competitor_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Winner surfaces read alongside the lead."
    },
    "auth_basis": {
      "type": "string",
      "enum": [
        "owned",
        "written_authorization",
        "staging_mirror"
      ],
      "enumColors": [
        "green",
        "blue",
        "purple"
      ],
      "description": "Why the lead surface is authorized for a read-only pass."
    },
    "attestation": {
      "type": "string",
      "description": "Who authorized the pass and for what."
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "complete",
        "failed"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "running"
    },
    "modules": {
      "type": "object",
      "description": "Gravity map, cognitive load and the agility index, plus refusals and limits."
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "target_url",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}