{
  "name": "TestAccount",
  "type": "object",
  "properties": {
    "target_url": {
      "type": "string",
      "description": "Registration URL that was exercised."
    },
    "site_label": {
      "type": "string",
      "description": "Human label for the gated site or app."
    },
    "alias_email": {
      "type": "string",
      "description": "Gmail plus-alias used for the test account."
    },
    "auth_method": {
      "type": "string",
      "enum": [
        "email_password",
        "magic_link",
        "otp_email",
        "oauth"
      ],
      "description": "How the account authenticates."
    },
    "status": {
      "type": "string",
      "enum": [
        "provisioned",
        "awaiting_verification",
        "verified",
        "failed",
        "expired"
      ],
      "description": "Lifecycle state of the test account."
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_state_ref": {
      "type": "string",
      "description": "Agent-side browser storage-state reference for authenticated captures."
    },
    "site_analysis_id": {
      "type": "string",
      "description": "Linked SiteAnalysis record id once the gated surface is analyzed."
    },
    "notes": {
      "type": "string"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "target_url",
    "alias_email",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}